# Copy to .env and fill in. Used by docker compose and, after
# `set -a; . ./.env; set +a`, by the local commands.

# Database (compose overrides DB_HOST with "db" inside the containers)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hunter
DB_USER=postgres
DB_PASSWORD=change-me

# Strava API app (https://www.strava.com/settings/api) and a refresh token
# with the activity:read_all scope, see README
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# Optional
SYNC_INTERVAL_SECONDS=3600
MAX_SEGMENT_METERS=500
GRAFANA_ADMIN_PASSWORD=admin
