# Copy to .env and fill in. Used by docker compose and, after
# `set -a; . ./.env; set +a`, by the local commands.

# Database (compose overrides DB_HOST with "db" inside the containers)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hunter
DB_USER=postgres
DB_PASSWORD=change-me

# Your Strava API application (https://www.strava.com/settings/api), see the
# README. Then use "Connect with Strava" on the map, no token needed here.
CLIENT_ID=
CLIENT_SECRET=

# Optional
# Public base URL of the map, used for Strava's redirect after connecting.
# Only needed behind a reverse proxy, e.g. https://hunter.example.org
PUBLIC_URL=
# Refresh token obtained by hand; only needed instead of "Connect with Strava"
REFRESH_TOKEN=
SYNC_INTERVAL_SECONDS=3600
MAX_SEGMENT_METERS=500
GRAFANA_ADMIN_PASSWORD=admin
